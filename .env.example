# 플로우 User API 키 — https://flow.team 설정에서 발급
# 문서: https://api.flow.team/docs
FLOW_API_KEY=

# Gemini API 키 — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 선택: 모델 체인(앞에서부터 시도, 소진되면 다음으로)
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# 데모 프로젝트 id — 서버 함수가 만질 수 있는 유일한 방이다
FLOW_DEMO_PROJECT_ID=

# 선택: 라이브 감사에 쓸 모델. 배포 함수 상한(60초) 안에 들어와야 한다
# LIVE_GEMINI_MODEL=gemini-3.1-flash-lite

# 선택: 라이브 감사 결과 재사용 시간(ms). 기본 1시간.
# 모델을 부르기 전에 플로우 글 목록의 지문을 먼저 보므로, 방이 안 바뀌면 이 시간과 무관하게 캐시를 쓴다.
# AUDIT_CACHE_MS=3600000

# 선택: 붙여넣기 시험에 쓸 모델 체인. 짧은 글 하나에 호출 1회라 상위 모델로 돈다
# TRY_GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# 선택: 화면의 「다시 감사」 버튼 가드. 한 번에 모델 2회를 쓴다
# AUDIT_FORCE_DAILY=5
# AUDIT_FORCE_PER_IP_MS=60000

# 선택: 화면 머리의 저장소 링크. 안 주면 빌드가 git 원격(또는 Vercel 저장소 변수)에서 찾고,
# 그것도 없으면 링크를 안 그린다
# REPO_URL=https://github.com/<owner>/<repo>

# 선택: API 베이스. 보통 안 건드린다
# FLOW_API_BASE=https://api.flow.team
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# 선택: 블록 융합 측정에 쓸 방(에디터로 쓴 글이 있어야 한다)
# FLOW_EDITOR_PROJECT_ID=
